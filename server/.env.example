# Copiare in .env (mai nel repository) oppure impostare nel pannello dell'hosting.

# Chiave segreta Stripe: sk_test_... per le prove, sk_live_... in produzione.
STRIPE_SECRET_KEY=sk_test_xxx
# Segreto dell'endpoint webhook (Dashboard Stripe > Sviluppatori > Webhook, oppure `stripe listen`).
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Origini del sito autorizzate, separate da virgola (senza percorso finale).
ALLOWED_ORIGINS=https://www.mycookiedelight.it,https://mycookiedelight.it,http://127.0.0.1:4201

# Destinatario delle email d'ordine.
ORDER_EMAIL_TO=mycookiedelight@gmail.com

# SMTP Gmail: SMTP_PASS e una "password per le app" di Google (richiede la verifica in due passaggi),
# non la password normale dell'account.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=mycookiedelight@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
# MAIL_FROM=My Cookie Delight <mycookiedelight@gmail.com>

# Cartella degli ordini in attesa di pagamento: deve sopravvivere ai riavvii (disco persistente).
# ORDERS_DIR=/var/data/orders
# ORDER_RETENTION_DAYS=30
# PORT=8787
